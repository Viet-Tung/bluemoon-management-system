# Server Settings
APP_NAME=BlueMoon Management System API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True

# Database (PostgreSQL 15+)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/bluemoon_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Security & JWT (NFR-001, US-28, US-44)
JWT_SECRET=bluemoon_super_secret_jwt_key_development_2026_change_in_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Password Policy (AC-44.1, AC-29.1)
BCRYPT_ROUNDS=12
MIN_PASSWORD_LENGTH=8

# Account Lockout Policy (US-28, AC-28.2, D-05)
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# Database Backup (US-45)
BACKUP_DIR=./backups
PG_DUMP_PATH=pg_dump

