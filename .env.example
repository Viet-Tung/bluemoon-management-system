# Docker Compose PostgreSQL settings
POSTGRES_DB=bluemoon_db
POSTGRES_USER=bluemoon_app
POSTGRES_PASSWORD=replace_with_a_strong_local_password

# Docker backend connection (backend runs on the host)
# Replace the placeholder credentials with the values used above.
DATABASE_URL=postgresql+psycopg://bluemoon_app:replace_with_a_strong_local_password@localhost:5432/bluemoon_db

# Copy this file to .env and replace all placeholders before starting Compose.
